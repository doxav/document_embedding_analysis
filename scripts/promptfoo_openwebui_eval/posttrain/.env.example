# Secrets stay in ignored files, not in profiles/job bundles.
OPENWEBUI_BASE_URL=http://127.0.0.1:8080
OPENWEBUI_API_KEY=
GENERATION_BACKEND=openwebui
OPENWEBUI_DEFAULT_SUMMARIZER_MODEL_ID=
OPENWEBUI_DEFAULT_ALGORITHM=
OPENWEBUI_DEFAULT_TARGET_LENGTH=
OPENWEBUI_DEFAULT_STRUCTURE=
OPENROUTER_API_KEY=
SA_UPSTREAM_URL=https://openrouter.ai/api/v1
SA_UPSTREAM_KEY=
SA_PROXY_TOKEN=
SA_ADMIN_TOKEN=
SA_CAPTURE_DIR=/absolute/private/capture
SA_API_BUDGET_DB=/absolute/private/api.sqlite
SA_PRICES_JSON={}
SA_CORRECTNESS_JUDGE=
SA_GROUNDING_JUDGE=
SA_JUDGE_URL=https://openrouter.ai/api/v1
SA_JUDGE_KEY=
# Inference only: these values never change the training context or USD ledgers.
# Spec > environment > defaults; output includes reasoning AND visible output.
# Absolute supported output ceiling: 50000 tokens per call / per episode.
SA_OUTPUT_TOKEN_CEILING=50000
SA_MAX_OUTPUT_TOKENS=8192
SA_JUDGE_MAX_OUTPUT_TOKENS=4096
# Conservative UTF-8 request-byte bounds (+512 bytes); these are NOT tokenizer counts.
# Collect/branch spec keys: max_input_bound_bytes, max_output_tokens.
SA_MAX_INPUT_BOUND=50000
SA_JUDGE_MAX_INPUT_BOUND=131072
# Seconds. Collect/branch may override request_timeout_seconds and collection_timeout_seconds.
SA_TEACHER_TIMEOUT_SECONDS=600
SA_JUDGE_TIMEOUT_SECONDS=300
SA_COLLECTION_TIMEOUT_SECONDS=900
SA_MAX_EPISODE_SECONDS=600
# Historical client bound is reported by the private bridge and must match the spec.
OPENWEBUI_TIMEOUT_SECONDS=600
# Optional historical native override, capped by SA_MAX_EPISODE_SECONDS:
# SA_NATIVE_MAX_SECONDS=600
# Cumulative episode limits; evaluation_limits in the spec overrides all four together.
SA_MAX_EPISODE_COMPLETION_TOKENS=50000
SA_MAX_LLM_CALLS=8
SA_MAX_TOOL_CALLS=8
# Verified chosen OpenRouter models only; check inventory before selecting other models.
# Explicit model_extra.reasoning in a collect/branch spec takes precedence.
# Leave teacher effort empty for an endpoint whose reasoning contract is unknown.
SA_TEACHER_REASONING_EFFORT=
# Check the chosen judge reasoning contract from its provider inventory.
# The judge helper sends this parameter only to the exact OpenRouter API endpoint.
SA_JUDGE_REASONING_EFFORT=low

# Dedicated Open WebUI native bridge; leave disabled until the instance is reviewed.
SA_NATIVE_INSTANCE_REVIEWED=false
SA_NATIVE_BASE_URL=http://127.0.0.1:18080
SA_NATIVE_STATE_DIR=/absolute/private/native-state
